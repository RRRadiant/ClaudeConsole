<Application x:Class="ClaudeCodePanel.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Infrastructure: ViewModel→View DataTemplates (never unloaded) -->
                <ResourceDictionary Source="Resources/Themes/ViewDataTemplates.xaml"/>
                <ResourceDictionary Source="Resources/Themes/ScrollBarStyles.xaml"/>
                <!-- Shared control styles (never unloaded) -->
                <ResourceDictionary Source="Views/Shared/GlassCard.xaml"/>
                <ResourceDictionary Source="Views/Shared/UtilityViews.xaml"/>
                <!-- Theme dictionary loaded by ThemeService at startup (Dark or Light) -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
