<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                    xmlns:dashboard="clr-namespace:ClaudeCodePanel.Windows.Views.Dashboard"
                    xmlns:api="clr-namespace:ClaudeCodePanel.Windows.Views.API"
                    xmlns:config="clr-namespace:ClaudeCodePanel.Windows.Views.Config"
                    xmlns:mcp="clr-namespace:ClaudeCodePanel.Windows.Views.MCP"
                    xmlns:skills="clr-namespace:ClaudeCodePanel.Windows.Views.Skills"
                    xmlns:installer="clr-namespace:ClaudeCodePanel.Windows.Views.Installer"
                    xmlns:envcheck="clr-namespace:ClaudeCodePanel.Windows.Views.EnvCheck">

    <!-- ============================================================
         ViewModel → View DataTemplates
         Extracted from DarkTheme.xaml so they survive theme swaps.
         These must NOT live inside any theme-specific dictionary.
         ============================================================ -->

    <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
        <dashboard:DashboardView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:APIConfigViewModel}">
        <api:APIConfigView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ConfigEditorViewModel}">
        <config:ConfigEditorView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:MCPManagerViewModel}">
        <mcp:MCPServerListView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:SkillManagerViewModel}">
        <skills:SkillsListView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:InstallerViewModel}">
        <installer:InstallerView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:EnvCheckViewModel}">
        <envcheck:EnvCheckView/>
    </DataTemplate>

</ResourceDictionary>
