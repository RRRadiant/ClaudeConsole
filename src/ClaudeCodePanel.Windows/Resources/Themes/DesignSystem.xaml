<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="LayoutWindowPadding">18</sys:Double>
    <sys:Double x:Key="LayoutSidebarWide">272</sys:Double>
    <sys:Double x:Key="LayoutSidebarLaptop">232</sys:Double>
    <sys:Double x:Key="LayoutSidebarCompact">76</sys:Double>
    <sys:Double x:Key="LayoutPagePaddingWide">36</sys:Double>
    <sys:Double x:Key="LayoutPagePaddingLaptop">28</sys:Double>
    <sys:Double x:Key="LayoutPagePaddingCompact">20</sys:Double>
    <sys:Double x:Key="LayoutContentMaxWidth">1460</sys:Double>

    <sys:Double x:Key="ControlHeightSmall">34</sys:Double>
    <sys:Double x:Key="ControlHeightRegular">42</sys:Double>
    <sys:Double x:Key="ControlHeightLarge">48</sys:Double>

    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.20</Duration>
    <Duration x:Key="MotionSlow">0:0:0.28</Duration>
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="MotionEaseInOut" EasingMode="EaseInOut"/>

    <Style x:Key="KeyboardFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            CornerRadius="12"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource FocusRingBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="LiquidToolbarStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="LiquidProminentStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}"/>
        <Setter Property="Background" Value="{DynamicResource GlassProminentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
