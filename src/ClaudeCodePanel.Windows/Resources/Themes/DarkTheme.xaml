<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
                    xmlns:converters="clr-namespace:ClaudeCodePanel.Windows.Converters">

    <!-- ============================================================
         Value Converters
         ============================================================ -->

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:BoolToVisibilityConverter x:Key="InvertBoolVisibilityConverter" Invert="True"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    <!-- ============================================================
         Liquid Glass Dark Theme — Claude Code Panel for Windows
         Design system ported from Claude-Win (Electron/React)

         Key references:
         - bg-0 (#080d1f) through bg-3 (#091020) depth layers
         - Surface glass: semi-transparent overlays on dark navy
         - Accent: #6faadd (light blue), pill-shaped buttons
         - Glass panels: multi-layer gradient backgrounds
         ============================================================ -->

    <!-- ═══════════════════════════════════════════════════════════
         Color Palette — Liquid Glass Design Tokens
         ═══════════════════════════════════════════════════════════ -->

    <!-- Window Background Gradient — used by MainWindow BgBorder -->
    <RadialGradientBrush x:Key="WindowBgBrush" Center="0.5,0" RadiusX="0.8" RadiusY="0.6">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#0C1731" Offset="0"/>
            <GradientStop Color="#070C1B" Offset="1"/>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowAmbientPrimaryBrush" Center="0.84,0.1" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#143E6A9A" Offset="0"/>
        <GradientStop Color="#003E6A9A" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowAmbientSecondaryBrush" Center="0.1,0.9" RadiusX="0.45" RadiusY="0.45">
        <GradientStop Color="#0CFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <!-- Background Depth Layers (dark navy) -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#080d1f"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#0f1a38"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#0d2540"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="#091020"/>

    <!-- Window & Content Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#080d1f"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0c0e18"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#800c0e18"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#080d1f"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#141828"/>

    <!-- Input & Editor Surface Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="DialogDimmingBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#14FFFFFF"/>

    <!-- Glass Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0FFFFFFF"/>              <!-- rgba(255,255,255,0.06) -->
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#14FFFFFF"/>        <!-- rgba(255,255,255,0.08) -->
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#08FFFFFF"/>          <!-- rgba(255,255,255,0.03) -->
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="#0CFFFFFF"/>          <!-- card base -->
    <SolidColorBrush x:Key="GlassCardBgAltBrush" Color="#08FFFFFF"/>       <!-- card alt -->
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#12FFFFFF"/>       <!-- card hover state -->
    <SolidColorBrush x:Key="GlassCardActiveBrush" Color="#06FFFFFF"/>      <!-- card active/pressed state -->
    <SolidColorBrush x:Key="GlassSubtleBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="GlassInteractiveBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="GlassProminentBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="GlassNavigationBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="GlassFallbackBrush" Color="#F20C1322"/>
    <SolidColorBrush x:Key="GlassRimBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="GlassRimStrongBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="GlassLowerEdgeBrush" Color="#52000000"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#B86FCBFF"/>
    <SolidColorBrush x:Key="ContentCanvasBrush" Color="#A8080F1D"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6faadd"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8bbaff"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1464b4ff"/>         <!-- rgba(100,180,255,0.08) -->
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4064b4ff"/>          <!-- rgba(100,180,255,0.25) -->
    <SolidColorBrush x:Key="AccentChromaticBrush" Color="#305BE7E7"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#ffffff"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF"/>          <!-- rgba(255,255,255,0.95) -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>       <!-- rgba(255,255,255,0.60) -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#59FFFFFF"/>        <!-- rgba(255,255,255,0.35) -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#26FFFFFF"/>           <!-- rgba(255,255,255,0.15) -->

    <!-- Status Colors — WCAG AA compliant on dark background -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34d399"/>          <!-- green-400: contrast 8.2:1 -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#fbbf24"/>          <!-- amber-400: contrast 8.8:1 -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#f87171"/>            <!-- red-400: contrast 5.8:1 -->
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#60a5fa"/>             <!-- blue-400: contrast 5.9:1 -->
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#1434d399"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#14fbbf24"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#14f87171"/>
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#1460a5fa"/>

    <!-- Legacy status aliases (backward compat) -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#34d399"/>
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="StatusRunningBgBrush" Color="#1434d399"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#1AFFFFFF"/>        <!-- rgba(255,255,255,0.10) -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#26FFFFFF"/>         <!-- rgba(255,255,255,0.15) -->
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#3364b4ff"/>         <!-- rgba(100,180,255,0.20) -->
    <SolidColorBrush x:Key="BorderCardBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderCardHoverBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#0CFFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent"/>

    <!-- ============================================================
         Corner Radius Scale
         ============================================================ -->
    <CornerRadius x:Key="RadiusMicro">2</CornerRadius>
    <CornerRadius x:Key="RadiusXs">8</CornerRadius>
    <CornerRadius x:Key="RadiusSm">12</CornerRadius>
    <CornerRadius x:Key="RadiusMd">16</CornerRadius>
    <CornerRadius x:Key="RadiusLg">20</CornerRadius>
    <CornerRadius x:Key="RadiusXl">24</CornerRadius>
    <CornerRadius x:Key="Radius2xl">28</CornerRadius>
    <CornerRadius x:Key="Radius3xl">32</CornerRadius>
    <CornerRadius x:Key="RadiusPill">22</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">26</CornerRadius>

    <!-- ============================================================
         Typography Scale
         ============================================================ -->
    <sys:Double x:Key="FontSizeXs" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeSm" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeLg" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSizeXl" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSize2xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FontSize3xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">30</sys:Double>

    <!-- ============================================================
         Spacing Scale (4px base unit)
         ============================================================ -->
    <sys:Double x:Key="Spacing1" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
    <sys:Double x:Key="Spacing2" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="Spacing3" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="Spacing4" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="Spacing5" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="Spacing6" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="Spacing8" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="Spacing10" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>

    <!-- ============================================================
         Global Styles
         ============================================================ -->

    <!-- Window background -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, PingFang SC, Microsoft YaHei, Noto Sans SC, sans-serif"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ScrollBar Thumb (theme-specific colors)
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource ScrollbarThumbBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Width="4"
                            HorizontalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbBorder"
                                                         Storyboard.TargetProperty="Width"
                                                         To="6" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="thumbBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#26FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbBorder"
                                                         Storyboard.TargetProperty="Width"
                                                         To="4" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="thumbBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#14FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Default TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}"/>
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}"/>
    </Style>

    <!-- Default Button -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
    </Style>

    <!-- Expander -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ProgressBar (indeterminate spinner) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
