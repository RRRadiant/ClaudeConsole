<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
                    xmlns:converters="clr-namespace:ClaudeCodePanel.Windows.Converters">

    <!-- ============================================================
         Value Converters
         ============================================================ -->

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:BoolToVisibilityConverter x:Key="InvertBoolVisibilityConverter" Invert="True"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    <!-- ============================================================
         Liquid Glass Dark Theme — Claude Code Panel for Windows
         Design system ported from Claude-Win (Electron/React)

         Key references:
         - bg-0 (#080d1f) through bg-3 (#091020) depth layers
         - Surface glass: semi-transparent overlays on dark navy
         - Accent: #6faadd (light blue), pill-shaped buttons
         - Glass panels: multi-layer gradient backgrounds
         ============================================================ -->

    <!-- ═══════════════════════════════════════════════════════════
         Color Palette — Liquid Glass Design Tokens
         ═══════════════════════════════════════════════════════════ -->

    <!-- Background Depth Layers (dark navy) -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#080d1f"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#0f1a38"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#0d2540"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="#091020"/>

    <!-- Window & Content Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#080d1f"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0c0e18"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#080d1f"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#141828"/>

    <!-- Glass Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0FFFFFFF"/>              <!-- rgba(255,255,255,0.06) -->
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#14FFFFFF"/>        <!-- rgba(255,255,255,0.08) -->
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#08FFFFFF"/>          <!-- rgba(255,255,255,0.03) -->
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="#0CFFFFFF"/>          <!-- card base -->
    <SolidColorBrush x:Key="GlassCardBgAltBrush" Color="#08FFFFFF"/>       <!-- card alt -->

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6faadd"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8bbaff"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1464b4ff"/>         <!-- rgba(100,180,255,0.08) -->
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4064b4ff"/>          <!-- rgba(100,180,255,0.25) -->

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF"/>          <!-- rgba(255,255,255,0.95) -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>       <!-- rgba(255,255,255,0.60) -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#59FFFFFF"/>        <!-- rgba(255,255,255,0.35) -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#26FFFFFF"/>           <!-- rgba(255,255,255,0.15) -->

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#4ea88d"/>          <!-- success green -->
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#59FFFFFF"/>        <!-- muted -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#cf6b6b"/>            <!-- danger red -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#d6a24a"/>          <!-- warning amber -->
    <SolidColorBrush x:Key="StatusRunningBgBrush" Color="#144ea88d"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#14cf6b6b"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#14d6a24a"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#1AFFFFFF"/>        <!-- rgba(255,255,255,0.10) -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#26FFFFFF"/>         <!-- rgba(255,255,255,0.15) -->
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#3364b4ff"/>         <!-- rgba(100,180,255,0.20) -->
    <SolidColorBrush x:Key="BorderCardBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderCardHoverBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#0CFFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent"/>

    <!-- ============================================================
         Global Styles
         ============================================================ -->

    <!-- Window background -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, PingFang SC, Microsoft YaHei, Noto Sans SC, sans-serif"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
    </Style>

    <!-- Default TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Default TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSubtleBrush}"/>
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSubtleBrush}"/>
    </Style>

    <!-- Default Button -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
    </Style>

    <!-- Expander -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ProgressBar (indeterminate spinner) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- DataTemplates for panel navigation -->
    <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.Dashboard">
        <views:DashboardView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:APIConfigViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.API">
        <views:APIConfigView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ConfigEditorViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.Config">
        <views:ConfigEditorView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:MCPManagerViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.MCP">
        <views:MCPServerListView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:SkillManagerViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.Skills">
        <views:SkillsListView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:InstallerViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.Installer">
        <views:InstallerView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:EnvCheckViewModel}"
                  xmlns:viewmodels="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
                  xmlns:views="clr-namespace:ClaudeCodePanel.Windows.Views.EnvCheck">
        <views:EnvCheckView/>
    </DataTemplate>

</ResourceDictionary>
