<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ClaudeCodePanel.Windows.Converters">

    <!-- Value Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:BoolToVisibilityConverter x:Key="InvertBoolVisibilityConverter" Invert="True"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    <!-- ============================================================
         Light Theme — Clean, airy, modern
         ============================================================ -->

    <!-- Window Background Gradient — used by MainWindow BgBorder -->
    <RadialGradientBrush x:Key="WindowBgBrush" Center="0.5,0" RadiusX="0.8" RadiusY="0.6">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#f8f9fa" Offset="0"/>
            <GradientStop Color="#e9ecef" Offset="1"/>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- Background Depth Layers -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#e9ecef"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#dee2e6"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="#f1f3f5"/>

    <!-- Window & Content Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#e8edf2"/>
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#ffffff"/>

    <!-- Input & Editor Surface Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#f1f3f5"/>
    <SolidColorBrush x:Key="DialogDimmingBrush" Color="#50000000"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#08000000"/>

    <!-- Glass Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="GlassCardBgAltBrush" Color="#f3f4f6"/>
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#f1f3f5"/>
    <SolidColorBrush x:Key="GlassCardActiveBrush" Color="#e9ecef"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563eb"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3b82f6"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1adbeafe"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#26dbeafe"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4b5563"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9ca3af"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#d1d5db"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#d97706"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#dc2626"/>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#2563eb"/>
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#14d1fae6"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#14fde68a"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#14fecaca"/>
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#14dbeafe"/>

    <!-- Legacy status aliases -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#059669"/>
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#9ca3af"/>
    <SolidColorBrush x:Key="StatusRunningBgBrush" Color="#14d1fae6"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#d4d7dd"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#bfc4cc"/>
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#7bb3f0"/>
    <SolidColorBrush x:Key="BorderCardBrush" Color="#d4d7dd"/>
    <SolidColorBrush x:Key="BorderCardHoverBrush" Color="#bac0c8"/>
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#e6e8ed"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#c4c8ce"/>
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent"/>

    <!-- ═══════════════════════════════════════════════════════════
         ScrollBar Thumb (light): 4px → 6px hover, #20000000 → #33000000
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource ScrollbarThumbBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Width="4"
                            HorizontalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbBorder"
                                                         Storyboard.TargetProperty="Width"
                                                         To="6" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="thumbBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#33000000" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbBorder"
                                                         Storyboard.TargetProperty="Width"
                                                         To="4" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="thumbBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#20000000" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Design Tokens (shared with dark theme) -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2xl">16</CornerRadius>
    <CornerRadius x:Key="Radius3xl">24</CornerRadius>
    <CornerRadius x:Key="Radius4xl">32</CornerRadius>

    <sys:Double x:Key="FontSizeXs" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeSm" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeLg" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSizeXl" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSize2xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FontSize3xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">30</sys:Double>

    <sys:Double x:Key="Spacing1" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
    <sys:Double x:Key="Spacing2" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="Spacing3" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="Spacing4" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="Spacing5" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="Spacing6" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="Spacing8" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="Spacing10" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>

    <!-- Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource GlassCardBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource GlassCardBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource GlassCardBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
