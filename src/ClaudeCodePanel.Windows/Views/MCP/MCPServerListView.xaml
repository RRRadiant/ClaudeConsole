<UserControl x:Class="ClaudeCodePanel.Windows.Views.MCP.MCPServerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             xmlns:mcp="clr-namespace:ClaudeCodePanel.Windows.Views.MCP">

    <ScrollViewer>
        <StackPanel Margin="48,36" HorizontalAlignment="Stretch">

            <!-- ═══ Header ═══ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <shared:SectionHeader Title="MCP Servers"
                                      Description="管理 MCP 服务器连接"/>

                <Button x:Name="AddBtn" Grid.Column="1"
                        Click="OnAddServer"
                        HorizontalAlignment="Right" Cursor="Hand"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Foreground="White" Padding="16,8"
                        VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        <TextBlock Text="添加" FontSize="14" FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══ Editor Form ═══ -->
            <mcp:MCPServerEditorView x:Name="EditorView" Visibility="Collapsed"/>

            <!-- ═══ Server Cards ═══ -->
            <StackPanel x:Name="ServerCardsPanel"/>

            <!-- ═══ Empty State ═══ -->
            <shared:EmptyState x:Name="EmptyStateView"
                               IconGlyph="&#xE946;"
                               Message="暂无 MCP 服务器"
                               Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
