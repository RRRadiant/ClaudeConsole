<UserControl x:Class="ClaudeCodePanel.Windows.Views.MCP.MCPServerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             MouseEnter="OnCardMouseEnter"
             MouseLeave="OnCardMouseLeave">

    <shared:GlassCard x:Name="CardRoot" Variant="Compact" Margin="0,0,0,12">
        <StackPanel>
            <!-- ═══ Header Row ═══ -->
            <Grid Background="Transparent"
                  MouseLeftButtonDown="OnHeaderClick">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TypeIcon"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel x:Name="NamePanel" Grid.Column="1" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EffectiveNameLabel"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="OriginalNameHint"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="ProjectPathLabel"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="ConnectionResultPanel" Grid.Column="2"
                      Margin="8,0">
                    <ProgressBar x:Name="TestingSpinner"
                                 Width="16" Height="16"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="UntestedLabel"
                               Text="未测试"
                               FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <shared:StatusIndicator x:Name="ConnectionStatus"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="MenuButton"
                        Grid.Column="3"
                        Width="28" Height="28"
                        Click="OnMenuButtonClick"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="0"
                        Visibility="Collapsed">
                    <TextBlock Text="&#xE712;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ═══ Context Menu ═══ -->
            <Popup x:Name="ContextMenuPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MenuButton}"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{StaticResource OverlayBackgroundBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="6"
                        MinWidth="140">
                    <StackPanel>
                        <Button x:Name="TestMenuBtn"
                                Click="OnTestFromMenu"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE704;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="测试连接" FontSize="15"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditMenuBtn"
                                Click="OnEditFromMenu"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="编辑…" FontSize="15"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Height="1" Fill="{StaticResource BorderDividerBrush}" Margin="8,2"/>
                        <Button x:Name="DeleteMenuBtn"
                                Click="OnDeleteFromMenu"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource StatusErrorBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="删除" FontSize="15"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ═══ Expanded Section ═══ -->
            <StackPanel x:Name="ExpandedSection" Visibility="Collapsed">
                <shared:GlassDivider Margin="0,8"/>

                <StackPanel x:Name="BadgeRow" Orientation="Horizontal"
                            Margin="0,0,0,8"/>

                <StackPanel x:Name="ProjectDetailPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="0,0,0,4">
                    <TextBlock Text="项目:" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="ProjectDetailPath"
                               FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="SSEDetailPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="0,0,0,2">
                    <TextBlock Text="URL:" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="SSEUrlLabel"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="StdioCmdPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="0,0,0,2">
                    <TextBlock Text="命令:" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="StdioCommandLabel"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="StdioArgsLabel"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="BuiltinPluginLabel"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="Collapsed"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="EnvCountLabel"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="Collapsed"
                           Margin="0,0,0,4"/>

                <shared:GlassDivider Margin="0,4"/>

                <!-- Rename edit mode -->
                <StackPanel x:Name="RenameEditPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="0,4,0,0">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="RenameInput"
                             FontSize="15"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             Background="{StaticResource SelectionBackgroundBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}"
                             BorderThickness="1"
                             Padding="6,3"
                             Width="180"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="OnRenameKeyDown"/>
                    <Button x:Name="RenameDoneBtn"
                            Click="OnRenameDoneClick"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="6,3"
                            Margin="4,0,0,0">
                        <TextBlock Text="完成" FontSize="12"/>
                    </Button>
                    <Button x:Name="RenameCancelBtn"
                            Click="OnRenameCancelClick"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Padding="4,3"
                            Margin="2,0,0,0">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- Rename idle mode -->
                <Button x:Name="RenameIdleBtn"
                        Click="OnStartRename"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Left"
                        Padding="0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="重命名显示" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Test Connection Button -->
                <Button x:Name="TestConnectionBtn"
                        Click="OnTestFromCard"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Stretch"
                        Padding="0,4"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="&#xE704;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="TestConnectionLabel"
                                   Text="测试连接"
                                   FontSize="15"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </shared:GlassCard>

</UserControl>
