<Window x:Class="ClaudeCodePanel.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sidebar="clr-namespace:ClaudeCodePanel.Windows.Views.Sidebar"
        Title="Claude Console"
        Width="1160"
        Height="820"
        MinWidth="940"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SourceInitialized="OnSourceInitialized">

    <Window.Resources>
        <!-- ── Title bar button style ── -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close button: danger-red hover ── -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cf6b6b"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#a85555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         Root Grid: background layers + title bar + content
         ═══════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>  <!-- Update banner -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Background layer (fills entire window behind everything) ── -->
        <Border Grid.RowSpan="3" Background="{StaticResource WindowBackgroundBrush}"/>

        <!-- ═══════════════════════════════════════════════════════════
             Title Bar (Row 0)
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Background="#0c0e18"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drag region: window title -->
            <TextBlock Grid.Column="0"
                       Text="Claude Console"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"/>

            <!-- Window control buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Content="&#xE921;"
                        Click="OnMinimizeClick"
                        ToolTip="Minimize"/>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Content="&#xE922;"
                        Click="OnMaximizeRestoreClick"
                        ToolTip="Maximize"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             Update Banner (Row 1) — shown only when IsUpdateAvailable
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#1A007AFF"
                BorderBrush="#33007AFF"
                BorderThickness="0,1,0,1"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Update icon -->
                <TextBlock Grid.Column="0"
                           Text="&#xE895;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#007AFF"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <!-- Update message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="发现新版本 "/>
                        <Run Text="{Binding UpdateVersion}" Foreground="#007AFF"/>
                        <Run Text=" — 点击下载更新"/>
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateReleaseNotes}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               MaxHeight="40"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Open / dismiss buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="下载更新"
                            Command="{Binding OpenUpdateUrlCommand}"
                            Background="#007AFF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Padding="16,6"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Click="OnDismissUpdateBanner">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             Content Area (Row 2): sidebar + main content
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sidebar — glass effect with blur simulation -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="24"
                                      Opacity="0.3"
                                      Color="#000000"/>
                </Border.Effect>
                <sidebar:SidebarView/>
            </Border>

            <!-- Right: Content area (each panel handles its own scrolling) -->
            <ContentControl Grid.Column="1"
                            Content="{Binding SelectedPanelViewModel}"/>
        </Grid>
    </Grid>
</Window>
