<Window x:Class="ClaudeCodePanel.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sidebar="clr-namespace:ClaudeCodePanel.Windows.Views.Sidebar"
        xmlns:helpers="clr-namespace:ClaudeCodePanel.Windows.Helpers"
        Title="Claude Console"
        Width="1160"
        Height="820"
        MinWidth="940"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SourceInitialized="OnSourceInitialized">

    <Window.Resources>
        <!-- ── Title bar button style ── -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#14FFFFFF" Duration="0:0:0.2">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.2">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close button: danger-red hover + glow ── -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="closeGlow"
                                                  ShadowDepth="0"
                                                  BlurRadius="8"
                                                  Opacity="0"
                                                  Color="#cf6b6b"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#cf6b6b" Duration="0:0:0.2">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="closeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.3" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.2">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="closeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         Window Chrome: rounded corners + shadow + radial bg
         ═══════════════════════════════════════════════════════════ -->
    <Border x:Name="WindowChromeBorder"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <!-- Shadow layer (behind content, hidden when maximized) -->
            <Border x:Name="WindowShadow"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    Margin="12">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4"
                                      BlurRadius="24"
                                      Opacity="0.4"
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

    <!-- ═══════════════════════════════════════════════════════════
         Root Grid: background layers + title bar + content
         ═══════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>  <!-- Update banner -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Theme-aware background (changes with dark/light) ── -->
        <Border Grid.RowSpan="3" x:Name="BgBorder"
                Background="{DynamicResource WindowBgBrush}"/>

        <!-- ═══════════════════════════════════════════════════════════
             Title Bar (Row 0) — frosted glass effect
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Background="{DynamicResource TitleBarBackgroundBrush}"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Blurred background layer (dark mode only) -->
            <Image x:Name="TitleBarBlurImage"
                   Grid.ColumnSpan="2"
                   Stretch="None"
                   IsHitTestVisible="False"
                   Opacity="0.6"
                   Visibility="Collapsed">
                <Image.Effect>
                    <BlurEffect Radius="10" RenderingBias="Quality"/>
                </Image.Effect>
            </Image>

            <!-- Drag region: window title -->
            <TextBlock Grid.Column="0"
                       Text="Claude Console"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="11"
                       Opacity="0.6"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"/>

            <!-- Window control buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Margin="0,0,0,0">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Content="&#xE921;"
                        Click="OnMinimizeClick"
                        ToolTip="Minimize"/>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Content="&#xE922;"
                        Click="OnMaximizeRestoreClick"
                        ToolTip="Maximize"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             Update Banner (Row 1) — shown only when IsUpdateAvailable
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource AccentGlowBrush}"
                BorderBrush="{DynamicResource BorderAccentBrush}"
                BorderThickness="0,1,0,1"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Update icon -->
                <TextBlock Grid.Column="0"
                           Text="&#xE895;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <!-- Update message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="发现新版本 "/>
                        <Run Text="{Binding UpdateVersion}" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text=" — 点击下载更新"/>
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateReleaseNotes}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxHeight="40"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Open / dismiss buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="下载更新"
                            Command="{Binding OpenUpdateUrlCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Padding="16,6"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Click="OnDismissUpdateBanner">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             Content Area (Row 2): sidebar + main content
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sidebar — glass effect with subtle gradient divider -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <!-- The sidebar content -->
                    <Border BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource BorderStrongBrush}">
                        <sidebar:SidebarView/>
                    </Border>
                    <!-- Right-edge gradient fade overlay -->
                    <Rectangle HorizontalAlignment="Right"
                               Width="4"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#08000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>

            <!-- Right: Content area with page-transition animation -->
            <ContentControl Grid.Column="1"
                            x:Name="ContentArea"
                            helpers:ContentTransitionBehavior.EnableContentTransition="True"/>
        </Grid>
    </Grid>
        </Grid>  <!-- closes the wrapper Grid inside WindowChromeBorder -->
    </Border>  <!-- closes WindowChromeBorder -->
</Window>
