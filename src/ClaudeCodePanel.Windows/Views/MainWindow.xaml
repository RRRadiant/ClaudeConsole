<Window x:Class="ClaudeCodePanel.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ClaudeCodePanel.Windows.Helpers"
        xmlns:sidebar="clr-namespace:ClaudeCodePanel.Windows.Views.Sidebar"
        Title="Claude Console"
        Width="1240"
        Height="860"
        MinWidth="980"
        MinHeight="660"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SourceInitialized="OnSourceInitialized">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
	                    <ControlTemplate TargetType="Button">
	                        <Border x:Name="border"
	                                CornerRadius="12"
	                                Background="{TemplateBinding Background}">
	                            <ContentPresenter HorizontalAlignment="Center"
	                                              VerticalAlignment="Center"/>
	                        </Border>
	                        <ControlTemplate.Triggers>
	                            <Trigger Property="IsMouseOver" Value="True">
	                                <Setter TargetName="border" Property="Background" Value="#cf6b6b"/>
	                                <Setter TargetName="border" Property="Effect">
	                                    <Setter.Value>
	                                        <DropShadowEffect ShadowDepth="0"
	                                                          BlurRadius="10"
	                                                          Opacity="0.35"
	                                                          Color="#cf6b6b"/>
	                                    </Setter.Value>
	                                </Setter>
	                                <Setter Property="Foreground" Value="White"/>
	                            </Trigger>
	                        </ControlTemplate.Triggers>
	                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowChromeBorder"
            CornerRadius="26"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="WindowShadow"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    Margin="18">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10"
                                      BlurRadius="28"
                                      Opacity="0.32"
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

            <Grid x:Name="RootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="3" Background="{DynamicResource WindowBgBrush}"/>

                <Ellipse Width="420"
                         Height="420"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-160,-120,0"
                         IsHitTestVisible="False"
                         Opacity="0.7">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#446FAADD" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="360"
                         Height="360"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-140,0,0,-180"
                         IsHitTestVisible="False"
                         Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#24FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Border Grid.Row="0"
                        Margin="18,12,18,0"
                        Height="40"
                        CornerRadius="18"
                        Background="{DynamicResource TitleBarBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <Image x:Name="TitleBarBlurImage"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Opacity="0.75"
                               Visibility="Collapsed">
                            <Image.Effect>
                                <BlurEffect Radius="14" RenderingBias="Quality"/>
                            </Image.Effect>
                        </Image>

                        <Grid Margin="14,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="9">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#60a5fa" Offset="0"/>
                                            <GradientStop Color="#7c3aed" Offset="0.58"/>
                                            <GradientStop Color="#f472b6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xE945;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Claude Console"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Windows control center"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,-1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,4"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="Glass workspace"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                                <Button x:Name="MinimizeButton"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Content="&#xE921;"
                                        Click="OnMinimizeClick"
                                        ToolTip="Minimize"/>
                                <Button x:Name="MaximizeRestoreButton"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Content="&#xE922;"
                                        Click="OnMaximizeRestoreClick"
                                        ToolTip="Maximize"
                                        Margin="6,0,0,0"/>
                                <Button x:Name="CloseButton"
                                        Style="{StaticResource TitleBarCloseButtonStyle}"
                                        Content="&#xE8BB;"
                                        Click="OnCloseClick"
                                        ToolTip="Close"
                                        Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="18,12,18,0"
                        Padding="18,12"
                        CornerRadius="18"
                        Background="{DynamicResource AccentGlowBrush}"
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE895;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="发现新版本 "/>
                                <Run Text="{Binding UpdateVersion}" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="，可立即下载。"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateReleaseNotes}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="38"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="下载更新"
                                    Command="{Binding OpenUpdateUrlCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="16,7"
                                    Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDismissUpdateBanner">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="18,12,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,14,0"
                            CornerRadius="28"
                            Background="{DynamicResource SurfaceStrongBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1">
                        <sidebar:SidebarView/>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="30"
                            Background="{DynamicResource SurfaceSoftBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            Padding="2">
                        <Border CornerRadius="28"
                                Background="{DynamicResource ContentBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Border Height="92"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Opacity="0.9"
                                        IsHitTestVisible="False"/>
                                <Rectangle Height="1"
                                           VerticalAlignment="Top"
                                           Margin="0,91,0,0"
                                           Fill="{DynamicResource BorderDividerBrush}"
                                           IsHitTestVisible="False"/>
                                <ContentControl x:Name="ContentArea"
                                                helpers:ContentTransitionBehavior.EnableContentTransition="True"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
