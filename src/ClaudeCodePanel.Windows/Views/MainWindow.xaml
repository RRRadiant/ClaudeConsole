<Window x:Class="ClaudeCodePanel.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ClaudeCodePanel.Windows.Helpers"
        xmlns:sidebar="clr-namespace:ClaudeCodePanel.Windows.Views.Sidebar"
        xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude Console"
        Width="1240"
        Height="860"
        MinWidth="760"
        MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SourceInitialized="OnSourceInitialized">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cf6b6b"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0"
                                                          BlurRadius="10"
                                                          Opacity="0.35"
                                                          Color="#cf6b6b"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="{DynamicResource RadiusPill}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowChromeBorder"
            CornerRadius="{DynamicResource RadiusWindow}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="WindowShadow"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    Margin="18">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="12"
                                      BlurRadius="34"
                                      Opacity="0.22"
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

            <Grid x:Name="RootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="3"
                        Background="{DynamicResource WindowBgBrush}"/>
                <Border Grid.RowSpan="3"
                        Background="{DynamicResource WindowAmbientPrimaryBrush}"
                        IsHitTestVisible="False"/>
                <Border Grid.RowSpan="3"
                        Background="{DynamicResource WindowAmbientSecondaryBrush}"
                        IsHitTestVisible="False"/>

                <Border Grid.Row="0"
                        Margin="18,12,18,0"
                        Height="40"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Background="{DynamicResource TitleBarBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <Grid Margin="14,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="{DynamicResource RadiusXs}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4F8CFF" Offset="0"/>
                                            <GradientStop Color="#59B2FF" Offset="0.58"/>
                                            <GradientStop Color="#69D3D8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xE945;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Claude Console"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Workspace settings"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,-1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="ShellToggleButton"
                                        Style="{StaticResource ShellToggleButtonStyle}"
                                        Content="原生界面"
                                        Click="OnShellToggleClick"
                                        ToolTip="在 Liquid Glass 和原生界面之间切换"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="MinimizeButton"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Content="&#xE921;"
                                        Click="OnMinimizeClick"
                                        ToolTip="Minimize"/>
                                <Button x:Name="MaximizeRestoreButton"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Content="&#xE922;"
                                        Click="OnMaximizeRestoreClick"
                                        ToolTip="Maximize"
                                        Margin="6,0,0,0"/>
                                <Button x:Name="CloseButton"
                                        Style="{StaticResource TitleBarCloseButtonStyle}"
                                        Content="&#xE8BB;"
                                        Click="OnCloseClick"
                                        ToolTip="Close"
                                        Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="NativeUpdateBanner"
                        Grid.Row="1"
                        Margin="18,12,18,0"
                        Padding="18,12"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Background="{DynamicResource AccentGlowBrush}"
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE895;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="发现新版本 "/>
                                <Run Text="{Binding UpdateVersion}" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="，可立即下载。"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateReleaseNotes}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="38"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="下载更新"
                                    Command="{Binding OpenUpdateUrlCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="16,7"
                                    Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDismissUpdateBanner">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="NativeWorkspace" Grid.Row="2" Margin="18,12,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="272"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SidebarHost"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            CornerRadius="{DynamicResource Radius2xl}"
                            Background="{DynamicResource GlassNavigationBrush}"
                            BorderBrush="{DynamicResource GlassRimBrush}"
                            BorderThickness="1">
                        <sidebar:SidebarView x:Name="SidebarView"/>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="{DynamicResource Radius2xl}"
                            Background="{DynamicResource GlassSubtleBrush}"
                            BorderBrush="{DynamicResource GlassRimBrush}"
                            BorderThickness="1"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource LiquidToolbarStyle}"
                                    Margin="0,0,0,8"
                                    Padding="22,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentPageTitle}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PageDescriptionText"
                                                   Text="{Binding CurrentPageDescription}"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="12,7"
                                            CornerRadius="{DynamicResource RadiusPill}"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            BorderBrush="{DynamicResource BorderAccentBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7"
                                                     Fill="{DynamicResource StatusSuccessBrush}"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Workspace ready"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    CornerRadius="{DynamicResource RadiusXl}"
                                    Background="{DynamicResource ContentCanvasBrush}"
                                    BorderBrush="{DynamicResource GlassRimBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <ContentControl x:Name="ContentArea"
                                                helpers:ContentTransitionBehavior.EnableContentTransition="True"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="WebShellHost"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="18,12,18,18"
                        CornerRadius="{DynamicResource Radius2xl}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="#07101C"
                        ClipToBounds="True"
                        Visibility="Collapsed"
                        Panel.ZIndex="20">
                    <webview2:WebView2CompositionControl x:Name="WebShellView"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        DefaultBackgroundColor="#07101C"
                                                        UseLayoutRounding="False"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
