<UserControl x:Class="ClaudeCodePanel.Windows.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             xmlns:models="clr-namespace:ClaudeCodePanel.Windows.Models">

    <UserControl.Resources>
        <!-- ── Event list item template ── -->
        <DataTemplate x:Key="EventItemTemplate" DataType="{x:Type models:DashboardEvent}">
            <Border x:Name="eventRow"
                    Padding="12,10"
                    Background="Transparent"
                    CornerRadius="{DynamicResource RadiusXs}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colored status dot -->
                    <Ellipse x:Name="eventDot"
                             Grid.Column="0"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0"
                                              BlurRadius="4"
                                              Opacity="0.4"
                                              Color="#6faadd"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Event message -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Message}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Timestamp -->
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Text>
                            <Binding Path="Timestamp"
                                     StringFormat="{}{0:HH:mm:ss}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Success">
                    <Setter TargetName="eventDot" Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Error">
                    <Setter TargetName="eventDot" Property="Fill" Value="{DynamicResource StatusErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Info">
                    <Setter TargetName="eventDot" Property="Fill" Value="{DynamicResource StatusInfoBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="48,36">

            <!-- ═══ Section Header ═══ -->
            <shared:SectionHeader Title="仪表盘"
                                  Description="概览 Claude Code 环境状态"
                                  Margin="0,0,0,32"/>

            <!-- ═══ 2×2 Card Grid ═══ -->
            <Grid Margin="0,0,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Card 1: Claude CLI ── -->
                <shared:GlassCard Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <Grid Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top row: status dot + label -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ClaudeStatusDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource TextTertiaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="Claude CLI"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Big number / version -->
                        <TextBlock Grid.Row="1"
                                   x:Name="ClaudeValueText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2"
                                   Text="当前版本"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,4,0,0"/>

                        <!-- Mini progress bar -->
                        <Rectangle x:Name="ClaudeProgressBar"
                                   Grid.Row="3"
                                   Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Left"
                                   Width="0"
                                   Margin="0,12,0,0">
                            <Rectangle.Clip>
                                <RectangleGeometry Rect="0,0,0,3"/>
                            </Rectangle.Clip>
                        </Rectangle>
                    </Grid>
                </shared:GlassCard>

                <!-- ── Card 2: API ── -->
                <shared:GlassCard Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <Grid Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ApiStatusDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource TextTertiaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="API 连接"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   x:Name="ApiValueText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Text="当前提供商"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,4,0,0"/>

                        <Rectangle x:Name="ApiProgressBar"
                                   Grid.Row="3"
                                   Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Left"
                                   Width="0"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </shared:GlassCard>

                <!-- ── Card 3: Skills ── -->
                <shared:GlassCard Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                    <Grid Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="SkillsStatusDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="已安装 Skill"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   x:Name="SkillsValueText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Text="个 Skill"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,4,0,0"/>

                        <Rectangle x:Name="SkillsProgressBar"
                                   Grid.Row="3"
                                   Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Left"
                                   Width="0"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </shared:GlassCard>

                <!-- ── Card 4: MCP Servers ── -->
                <shared:GlassCard Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                    <Grid Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="McpStatusDot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource TextTertiaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="MCP 服务"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   x:Name="McpValueText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Text="运行中 / 总数"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,4,0,0"/>

                        <Rectangle x:Name="McpProgressBar"
                                   Grid.Row="3"
                                   Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Left"
                                   Width="0"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </shared:GlassCard>
            </Grid>

            <!-- ═══ Recent Events ═══ -->
            <shared:GlassDivider Margin="0,0,0,8"/>

            <TextBlock Text="最近事件"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Events list -->
            <ItemsControl x:Name="EventsItemsControl"
                          ItemTemplate="{StaticResource EventItemTemplate}"
                          Focusable="False"
                          Visibility="Visible"/>

            <!-- Empty state (shown when no events) -->
            <shared:EmptyState x:Name="EventsEmptyState"
                               IconGlyph="&#xE943;"
                               Message="暂无事件记录"
                               Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
