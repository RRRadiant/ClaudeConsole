<UserControl x:Class="ClaudeCodePanel.Windows.Views.Sidebar.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:ClaudeCodePanel.Windows.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Padding="12,10"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="accentBar"
                                        Width="3"
                                        CornerRadius="{DynamicResource RadiusMicro}"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Margin="-2,8,0,8"
                                        Opacity="0"/>

                                <Grid Margin="6,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="iconShell"
                                            Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="{DynamicResource RadiusSm}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Data="{Binding IconPathData}"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"/>
                                        </Viewbox>
                                    </Border>

                                    <StackPanel x:Name="navTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Ellipse x:Name="activeDot"
                                             Grid.Column="2"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                <Setter TargetName="iconShell" Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
                                <Setter TargetName="accentBar" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppearanceModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarUtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SidebarRoot" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="BrandPanel"
                Grid.Row="0"
                CornerRadius="{DynamicResource RadiusXl}"
                Background="{DynamicResource GlassCardBgBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="{DynamicResource RadiusMd}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#59B2FF" Offset="0.58"/>
                                <GradientStop Color="#69D3D8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Claude Console"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Windows manager"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,16,0,0"
                        Padding="14"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="当前工作区"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Claude Code 主环境"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="系统设置、API、MCP 与环境工具统一收纳在一个轻量工作台。"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid x:Name="NavigationRegion" Grid.Row="1" Margin="0,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="{DynamicResource RadiusXl}"
                    Background="{DynamicResource GlassNavigationBrush}"
                    BorderBrush="{DynamicResource GlassRimBrush}"
                    BorderThickness="1"
                    Padding="10">
                <ScrollViewer x:Name="NavigationScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="ItemsControl"
                                      ItemsSource="{Binding SidebarItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SidebarItem}">
                                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                                            Tag="{Binding PanelType}"
                                            MouseEnter="OnItemMouseEnter"
                                            MouseLeave="OnItemMouseLeave"
                                            Click="OnItemClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="UtilityPanel" Grid.Row="1" Margin="0,14,0,0">
                <Button x:Name="AppearanceToggleButton"
                        Style="{StaticResource SidebarUtilityButtonStyle}"
                        Click="OnAppearanceToggleClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32"
                                Height="32"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource BorderAccentBrush}"
                                BorderThickness="1">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppearanceToggleLabelText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="AppearanceToggleHintText"
                                       Text="主题与强调色"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="AppearanceToggleChevron"
                                   Grid.Column="2"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Border x:Name="AppearancePanel"
                        Margin="0,8,0,0"
                        Padding="14"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Background="{DynamicResource GlassSubtleBrush}"
                        BorderBrush="{DynamicResource GlassRimBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        ClipToBounds="True">
                    <StackPanel>
                        <TextBlock x:Name="AppearanceHeadingText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>

                        <primitives:UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="ThemeModeSystemButton"
                                    Style="{StaticResource AppearanceModeButtonStyle}"
                                    Tag="System"
                                    Click="OnThemeModeClick"/>
                            <Button x:Name="ThemeModeLightButton"
                                    Style="{StaticResource AppearanceModeButtonStyle}"
                                    Tag="Light"
                                    Click="OnThemeModeClick"/>
                            <Button x:Name="ThemeModeDarkButton"
                                    Style="{StaticResource AppearanceModeButtonStyle}"
                                    Tag="Dark"
                                    Click="OnThemeModeClick"/>
                            <Button x:Name="ThemeModeCustomButton"
                                    Style="{StaticResource AppearanceModeButtonStyle}"
                                    Tag="Custom"
                                    Click="OnThemeModeClick"/>
                        </primitives:UniformGrid>

                        <Border Margin="0,6,0,0"
                                Padding="12"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{DynamicResource GlassCardBgBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="AccentPreviewSwatch"
                                             Width="18"
                                             Height="18"
                                             VerticalAlignment="Top"
                                             Margin="0,3,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="AccentLabelText"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="AccentHintText"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,3,8,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock x:Name="AccentHexText"
                                               Grid.Column="2"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Top"
                                               Margin="8,3,0,0"/>
                                </Grid>

                                <Button x:Name="PickAccentButton"
                                        Style="{StaticResource SidebarUtilityButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,10,0,0"
                                        Padding="10,7"
                                        Click="OnPickAccentClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="LangToggleButton"
                        Style="{StaticResource SidebarUtilityButtonStyle}"
                        Margin="0,8,0,0"
                        Click="OnLanguageToggleClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE8B4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock x:Name="LanguageLabelText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="LanguageHintText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="&#xE72A;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="{DynamicResource RadiusLg}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="14">
            <StackPanel>
                <TextBlock Text="{Binding CurrentVersionText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UpdateStatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Command="{Binding DoCheckUpdateCommand}"
                        Style="{StaticResource SidebarUtilityButtonStyle}"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE895;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Check for Updates"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
