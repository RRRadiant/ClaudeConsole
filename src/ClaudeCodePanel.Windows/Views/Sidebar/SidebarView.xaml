<UserControl x:Class="ClaudeCodePanel.Windows.Views.Sidebar.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
             Width="220">

    <UserControl.Resources>
        <!-- ── Nav item button style ── -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="12,0"
                                Margin="5,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock x:Name="iconBlock"
                                           Grid.Column="0"
                                           Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="20"
                                           Width="28"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Active dot indicator -->
                                <Ellipse x:Name="activeDot"
                                         Grid.Column="2"
                                         Width="10"
                                         Height="10"
                                         Fill="{StaticResource AccentBrush}"
                                         Visibility="Collapsed"
                                         Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="0"
                                                          BlurRadius="8"
                                                          Opacity="0.5"
                                                          Color="#6faadd"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         Sidebar Layout
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Brand -->
            <RowDefinition Height="*"/>      <!-- Nav -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0 — Brand ═══ -->
        <StackPanel Grid.Row="0" Margin="18,22,18,14">
            <StackPanel Orientation="Horizontal">
                <!-- Logo icon with gradient background -->
                <Border Width="42" Height="42"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6faadd" Offset="0"/>
                            <GradientStop Color="#7c8bff" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0"
                                          BlurRadius="12"
                                          Opacity="0.4"
                                          Color="#6faadd"/>
                    </Border.Effect>
                    <!-- Lightning bolt icon -->
                    <TextBlock Text="&#xE945;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Brand text -->
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Claude Code"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manager"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider under brand -->
            <Rectangle Height="1"
                       Fill="{StaticResource BorderDefaultBrush}"
                       Margin="0,14,0,0"/>
        </StackPanel>

        <!-- ═══ Row 1 — Navigation ═══ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsControl"
                          Margin="0,4,0,0"
                          Focusable="False"
                          ItemsSource="{Binding SidebarItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SidebarItem}">
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Tag="{Binding PanelType}"
                                MouseEnter="OnItemMouseEnter"
                                MouseLeave="OnItemMouseLeave"
                                Click="OnItemClick"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ Row 2 — Footer ═══ -->
        <StackPanel Grid.Row="2">
            <Rectangle Height="1"
                       Fill="{StaticResource BorderDefaultBrush}"
                       Margin="16,0"/>

            <!-- Version + update status -->
            <StackPanel Margin="16,10,16,12">
                <TextBlock FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}">
                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="7" Height="7"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusText}" Value="已是最新">
                                        <Setter Property="Fill" Value="{StaticResource StatusRunningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UpdateStatusText}" Value="检查中…">
                                        <Setter Property="Fill" Value="#999999"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UpdateStatusText}" Value="发现新版本">
                                        <Setter Property="Fill" Value="{StaticResource StatusErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding UpdateStatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Manual check button -->
                <Button Command="{Binding DoCheckUpdateCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Padding="10,5"
                        Margin="0,8,0,0"
                        Cursor="Hand"
                        HorizontalAlignment="Left">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="检查更新"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#14FFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
