<UserControl x:Class="ClaudeCodePanel.Windows.Views.Skills.SkillCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             Loaded="OnLoaded">

    <Grid>
        <!-- ═══ Installed mode — compact horizontal row ═══ -->
        <Border x:Name="InstalledRoot"
                CornerRadius="{DynamicResource RadiusXs}"
                Background="Transparent"
                Height="52"
                Padding="16,0"
                MouseEnter="OnInstalledMouseEnter"
                MouseLeave="OnInstalledMouseLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE94A;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="InstalledName"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InstalledDesc"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"/>
                </StackPanel>

                <shared:Badge x:Name="StatusBadge" Grid.Column="2"
                             Variant="Success" Text="已启用"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>

                <Button x:Name="MenuButton" Grid.Column="3"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnMenuButtonClick">
                    <Button.Content>
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button.Content>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ActionMenu"
                                     Background="{DynamicResource OverlayBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderStrongBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}">
                            <MenuItem x:Name="ToggleMenuItem" Click="OnToggleClick">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ToggleIcon"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Text="&#xE769;"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleLabel"
                                                   Text="禁用"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Click="OnDeleteClick">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Text="&#xE74D;"
                                                   Foreground="{DynamicResource StatusErrorBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="删除"
                                                   Foreground="{DynamicResource StatusErrorBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Marketplace mode — GlassCard(Compact) ═══ -->
        <Border x:Name="MarketplaceRoot"
                CornerRadius="{DynamicResource RadiusXl}"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="20"
                Visibility="Collapsed"
                MouseEnter="OnMarketplaceMouseEnter"
                MouseLeave="OnMarketplaceMouseLeave">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE94A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="MarketplaceName"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel x:Name="StarsRow" Orientation="Horizontal"
                            Margin="0,0,0,6" Visibility="Collapsed">
                    <TextBlock Text="&#xE734;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="#FFD60A"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StarsCount"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="MarketplaceDesc"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="44"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <shared:Badge x:Name="InstalledBadge"
                                 Variant="Success" Text="已安装"
                                 Visibility="Collapsed"/>

                    <Button x:Name="InstallButton"
                            Click="OnInstallButtonClick"
                            Cursor="Hand"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Padding="16,7"
                            Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"/>
                            <TextBlock Text="安装"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
