<UserControl x:Class="ClaudeCodePanel.Windows.Views.Skills.SkillInstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{StaticResource OverlayBackgroundBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                Padding="28"
                Width="500">
            <StackPanel>
                <TextBlock Text="安装技能"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

                <!-- Source picker tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ToggleButton x:Name="LocalPathTab"
                                  Click="OnSourceTab" Tag="LocalPath"
                                  Cursor="Hand" Padding="16,9"
                                  BorderThickness="0"
                                  FontSize="14" FontWeight="SemiBold"
                                  IsChecked="True">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border" CornerRadius="20"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <TextBlock Text="本地路径"/>
                    </ToggleButton>

                    <ToggleButton x:Name="GitUrlTab"
                                  Click="OnSourceTab" Tag="GitURL"
                                  Cursor="Hand" Padding="16,9"
                                  BorderThickness="0"
                                  FontSize="14" FontWeight="SemiBold"
                                  Margin="2,0,0,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border" CornerRadius="20"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <TextBlock Text="Git URL"/>
                    </ToggleButton>
                </StackPanel>

                <shared:GlassTextField x:Name="InstallPath"
                                      Variant="Regular"
                                      Placeholder="/path/to/skill"
                                      Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Click="OnCancelClick"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Padding="16,10">
                        <TextBlock Text="取消" FontSize="15"/>
                    </Button>

                    <Button x:Name="InstallConfirmButton"
                            Click="OnInstallClick"
                            Cursor="Hand"
                            Margin="12,0,0,0"
                            Background="{StaticResource AccentBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            Padding="22,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"/>
                            <TextBlock Text="安装"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
