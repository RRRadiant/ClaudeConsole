<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <!-- ═══════════════════════════════════════════════════════════
         GlassCard — Liquid Glass panel control
         Matches .glass-panel / .glass-card from Claude-Win

         Variants:
           "Default" — Standard glass panel (radius-xl=28px, blur simulation)
           "Compact" — Compact card (radius-lg=20px)
           "Plain"   — No border, no hover, content only
           "Aurora"  — Enhanced glass with stronger highlight
           "Signal"  — Blue-tinted status panel
         ═══════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type shared:GlassCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:GlassCard}">
                    <!-- Outer border: carries corner radius, clips content, handles hover -->
                    <Border x:Name="OuterBorder"
                            CornerRadius="32"
                            ClipToBounds="True">

                        <!-- Inner border: provides the stroke -->
                        <Border x:Name="StrokeBorder"
                                CornerRadius="32"
                                BorderThickness="1"
                                ClipToBounds="True">

                            <!-- Multi-layer background simulation -->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#08FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0F000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!-- Content layout grid -->
                            <Grid x:Name="LayoutGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title (optional) -->
                                <TextBlock x:Name="TitleTextBlock"
                                           Grid.Row="0"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed"/>

                                <!-- Content -->
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"/>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
