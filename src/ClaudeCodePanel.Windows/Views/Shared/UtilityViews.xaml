<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <!-- ── SectionHeader ──────────────────────────────────────────────
         Matches .section-header from Claude-Win:
         Large bold title + description + optional aside action area
         ─────────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type shared:SectionHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:SectionHeader}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   LineHeight="28"/>
                        <TextBlock Text="{TemplateBinding Description}"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,10,0,0"
                                   LineHeight="24"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── GlassDivider ───────────────────────────────────────────────
         Thin semi-transparent horizontal divider
         ─────────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type shared:GlassDivider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:GlassDivider}">
                    <Rectangle Fill="{StaticResource BorderDividerBrush}"
                               Height="1"
                               Margin="0,12,0,12"
                               HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── EmptyState ─────────────────────────────────────────────────
         Centered icon + message placeholder
         ─────────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type shared:EmptyState}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:EmptyState}">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="40">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding IconGlyph}"
                                       FontSize="48"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Message}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
