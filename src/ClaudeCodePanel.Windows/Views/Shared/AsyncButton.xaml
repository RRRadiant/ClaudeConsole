<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.AsyncButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder"
            Height="44"
            CornerRadius="22"
            ClipToBounds="True"
            Cursor="Hand"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseLeftButtonUp="OnMouseLeftButtonUp">

        <Grid>
            <!-- Idle State -->
            <StackPanel x:Name="IdlePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="IconGlyphElement"
                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="TitleTextBlock"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Loading State -->
            <StackPanel x:Name="LoadingPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressBar x:Name="LoadingProgress"
                             Width="16" Height="16"
                             IsIndeterminate="True"/>
            </StackPanel>

            <!-- Success checkmark -->
            <TextBlock x:Name="SuccessIcon"
                       Text="&#xE8FB;"
                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Error X -->
            <TextBlock x:Name="ErrorIcon"
                       Text="&#xE711;"
                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
