<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.GlassTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 — Input area -->
        <Border x:Name="RootBorder"
                Grid.Row="0"
                CornerRadius="16"
                ClipToBounds="False">

            <Border.Effect>
                <DropShadowEffect x:Name="GlowShadow"
                                  ShadowDepth="0"
                                  BlurRadius="0"
                                  Opacity="0"
                                  Color="#6faadd"/>
            </Border.Effect>

            <Border x:Name="StrokeBorder"
                    CornerRadius="16"
                    BorderThickness="1"
                    Background="{DynamicResource InputBackgroundBrush}"
                    ClipToBounds="True">

                <Grid x:Name="ContentGrid"
                      Margin="16,0,16,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 — input + watermark -->
                    <Grid Grid.Column="0">
                        <TextBlock x:Name="WatermarkBlock"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Text=""
                                   Visibility="Collapsed"/>

                        <TextBox x:Name="InputTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 GotFocus="OnGotFocus"
                                 LostFocus="OnLostFocus"
                                 TextChanged="OnTextBoxTextChanged"/>

                        <PasswordBox x:Name="InputPasswordBox"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     GotFocus="OnGotFocus"
                                     LostFocus="OnLostFocus"
                                     PasswordChanged="OnPasswordBoxPasswordChanged"
                                     Visibility="Collapsed"/>
                    </Grid>

                    <!-- Column 1 — show/hide toggle -->
                    <Button x:Name="ToggleSecureButton"
                            Grid.Column="1"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Content="&#xE052;"
                            Click="OnToggleSecureClick"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Border>

        <!-- Row 1 — error message -->
        <TextBlock x:Name="ErrorMessageBlock"
                   Grid.Row="1"
                   FontSize="13"
                   Foreground="{DynamicResource StatusErrorBrush}"
                   Margin="16,5,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
