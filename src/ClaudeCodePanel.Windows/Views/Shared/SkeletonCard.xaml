<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.SkeletonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto">

    <!-- ═══════════════════════════════════════════════════════════
         SkeletonCard — Loading placeholder matching GlassCard
         Shows 3 rounded placeholder rectangles + shimmer sweep.
         Swaps to real content when IsLoading becomes false.
         ═══════════════════════════════════════════════════════════ -->

    <Grid>
        <!-- ── Skeleton shimmer layer (visible when loading) ── -->
        <Border x:Name="SkeletonLayer"
                CornerRadius="32"
                ClipToBounds="True"
                Visibility="Visible">
            <!-- Glass-like gradient background -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#08FFFFFF" Offset="0"/>
                    <GradientStop Color="#0F000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Placeholder: title bar -->
                    <Border Grid.Row="0"
                            Height="18"
                            Width="160"
                            CornerRadius="6"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <Border.Background>
                            <SolidColorBrush Color="#0FFFFFFF"/>
                        </Border.Background>
                    </Border>

                    <!-- Placeholder: body lines -->
                    <StackPanel Grid.Row="1">
                        <Border Height="12"
                                CornerRadius="4"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,60,10">
                            <Border.Background>
                                <SolidColorBrush Color="#0FFFFFFF"/>
                            </Border.Background>
                        </Border>
                        <Border Height="12"
                                CornerRadius="4"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,120,10">
                            <Border.Background>
                                <SolidColorBrush Color="#0FFFFFFF"/>
                            </Border.Background>
                        </Border>
                        <Border Height="12"
                                CornerRadius="4"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,40,10">
                            <Border.Background>
                                <SolidColorBrush Color="#0FFFFFFF"/>
                            </Border.Background>
                        </Border>
                    </StackPanel>

                    <!-- Placeholder: button -->
                    <Border Grid.Row="2"
                            Height="34"
                            Width="120"
                            CornerRadius="17"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="#0FFFFFFF"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- ── Shimmer sweep overlay ── -->
                <Border x:Name="ShimmerOverlay"
                        IsHitTestVisible="False"
                        Opacity="0.6">
                    <Border.Background>
                        <LinearGradientBrush x:Name="ShimmerBrush"
                                             StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ShimmerTranslate" X="-1"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- ── Real content layer (visible when loaded) ── -->
        <ContentPresenter x:Name="ContentLayer"
                          Visibility="Collapsed"/>
    </Grid>
</UserControl>
