<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.GlassButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <!-- ═══════════════════════════════════════════════════════════
         GlassButton — Liquid Glass rounded button
         Matches .glass-button from Claude-Win

         Variants:
           "Primary"   — Strong white-on-glass (default)
           "Secondary" — Muted text, subtle glass bg
           "Ghost"     — Transparent, bordered on hover
           "Accent"    — Blue-tinted glass, accent border + glow
           "Danger"    — Red-tinted border + text
         Sizes:
           "Regular"   — height 38, padding 18, font 0.88rem (~14px)
           "Small"     — height 30, padding 12, font 0.82rem (~13px)
         ═══════════════════════════════════════════════════════════ -->

    <Border x:Name="RootBorder"
            CornerRadius="{DynamicResource RadiusPill}"
            FocusVisualStyle="{StaticResource KeyboardFocusVisualStyle}"
            ClipToBounds="True"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseLeftButtonUp="OnMouseLeftButtonUp">

        <Border.RenderTransform>
            <ScaleTransform x:Name="PressScale" ScaleX="1.0" ScaleY="1.0"/>
        </Border.RenderTransform>

        <!-- Grid container to layer highlight + content -->
        <Grid>
            <!-- Inner highlight (top edge microstructure) -->
            <Border CornerRadius="{DynamicResource RadiusPill}" BorderThickness="0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.14"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel x:Name="ContentStack"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Icon glyph -->
                <TextBlock x:Name="IconGlyphElement"
                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"
                           Visibility="Collapsed"/>

                <!-- Title text -->
                <TextBlock x:Name="TitleTextBlock"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
