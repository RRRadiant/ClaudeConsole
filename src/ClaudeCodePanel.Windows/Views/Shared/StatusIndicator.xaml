<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">

    <StackPanel Orientation="Horizontal">
        <!-- Status dot with color-matched drop shadow -->
        <Ellipse x:Name="StatusEllipse"
                 Width="7" Height="7"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource StatusStoppedBrush}"
                 Opacity="0.5">
            <Ellipse.Effect>
                <DropShadowEffect x:Name="DotGlow"
                                  ShadowDepth="0"
                                  BlurRadius="6"
                                  Opacity="0.4"
                                  Color="#999999"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock x:Name="LabelTextBlock"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
