<UserControl x:Class="ClaudeCodePanel.Windows.Views.Shared.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">

    <Border x:Name="RootBorder"
            CornerRadius="16"
            ClipToBounds="False">

        <Border.Effect>
            <DropShadowEffect x:Name="GlowShadow"
                              ShadowDepth="0"
                              BlurRadius="0"
                              Opacity="0"
                              Color="#6faadd"/>
        </Border.Effect>

        <Border x:Name="StrokeBorder"
                CornerRadius="16"
                BorderThickness="1"
                Background="{DynamicResource InputBackgroundBrush}"
                ClipToBounds="True">

            <Grid x:Name="ContentGrid"
                  Height="38"
                  Margin="14,0,14,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search icon -->
                <TextBlock x:Name="SearchIconBlock"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Text="&#xE721;"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Watermark + TextBox overlay -->
                <Grid Grid.Column="1">
                    <TextBlock x:Name="WatermarkBlock"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Text=""
                               Visibility="Collapsed"/>

                    <TextBox x:Name="InputTextBox"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             GotFocus="OnGotFocus"
                             LostFocus="OnLostFocus"
                             TextChanged="OnTextChanged"/>
                </Grid>

                <!-- Clear button -->
                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Width="20" Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xE711;"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        Click="OnClearClick"
                        Visibility="Collapsed"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
