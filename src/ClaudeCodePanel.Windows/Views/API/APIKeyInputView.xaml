<UserControl x:Class="ClaudeCodePanel.Windows.Views.API.APIKeyInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             Loaded="OnLoaded">

    <!--
        APIKeyInputView — a reusable UserControl for entering a provider API key.

        Matches the Swift APIKeyInputView:
          - Header row: green status indicator when key saved ("已保存到 Credential Manager，并同步到 Claude Code 配置"),
            or tertiary hint text when no key is saved ("输入后会保存并同步到 Claude Code 配置")
          - Copy-to-clipboard button (visible only when the text is non-empty)
          - GlassTextField with Variant="Secure" for password-style input

        Dependency Properties:
          - ApiKey         (string)  — the API key text (two-way bindable)
          - IsKeySaved     (bool)    — true → green status, false → hint text
          - ProviderName   (string)  — used in the placeholder: "输入 {ProviderName} API Key"
    -->

    <StackPanel>
        <!-- ═══════════════════════════════════════════════════════════════════
             Header Row: Status Indicator + Copy Button
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: status indicator (green when saved, gray otherwise) -->
            <shared:StatusIndicator x:Name="KeyStatus"
                                    Grid.Column="0"
                                    Label="输入后会保存并同步到 Claude Code 配置"
                                    Status="Stopped"/>

            <!-- Right: copy-to-clipboard button (shown only when text is non-empty) -->
            <Button x:Name="CopyKeyBtn"
                    Grid.Column="1"
                    Click="OnCopyKey"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Cursor="Hand"
                    Padding="4"
                    ToolTip="复制 API Key">
                <TextBlock Text="&#xE8C8;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Secure Text Field
             ═══════════════════════════════════════════════════════════════════ -->
        <shared:GlassTextField x:Name="ApiKeyField"
                               Variant="Secure"
                               Placeholder="输入 API Key"
                               Width="400"
                               HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
