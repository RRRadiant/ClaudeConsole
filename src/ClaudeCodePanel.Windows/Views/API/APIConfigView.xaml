<UserControl x:Class="ClaudeCodePanel.Windows.Views.API.APIConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="FeaturePanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#247D89FF" Offset="0"/>
            <GradientStop Color="#10FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PagePanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
            <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SectionMetaStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{DynamicResource GlassInteractiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        </Style>

        <Style x:Key="InlineTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ProviderRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Margin="32,28" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="API 配置"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="为当前工作空间配置主模型、备用模型和密钥策略。"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="TestConnBtn"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="OnTestConnection"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE704;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"/>
                            <TextBlock Text="测试连接"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveBtn"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Click="OnSaveConfig">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"/>
                            <TextBlock Text="保存配置"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource PagePanelStyle}"
                    Background="{StaticResource FeaturePanelBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="提供商"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="默认提供商与 API 路由入口"
                                       Style="{StaticResource SectionMetaStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource GlassCardBgBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock Text="默认 / 自动回退"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ProviderList"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PagePanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="API Key"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="凭据保存到 Windows Credential Manager"
                                           Style="{StaticResource SectionMetaStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button x:Name="CopyKeyBtn"
                                    Grid.Column="1"
                                    Click="OnCopyKey"
                                    Visibility="Collapsed"
                                    Style="{StaticResource InlineTextButtonStyle}"
                                    ToolTip="复制 API Key">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>
                        </Grid>

                        <shared:GlassTextField x:Name="ApiKeyField"
                                               Placeholder="输入 API Key"
                                               Variant="Secure"
                                               HorizontalAlignment="Stretch"/>

                        <shared:StatusIndicator x:Name="KeyStatus"
                                                Label="输入后会保存并同步到 Claude Code 配置"
                                                Status="Stopped"
                                                Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource PagePanelStyle}">
                    <StackPanel>
                        <Expander x:Name="AdvancedExpander"
                                  Header="高级选项"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsExpanded="False"
                                  Expanded="OnAdvancedExpanded"
                                  Collapsed="OnAdvancedCollapsed">
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Base URL"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <shared:GlassTextField x:Name="BaseUrlField"
                                                       Variant="Regular"
                                                       Placeholder="https://api.anthropic.com"
                                                       Margin="0,0,0,14"/>

                                <TextBlock Text="最大令牌数"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <shared:GlassTextField x:Name="MaxTokensField"
                                                       Variant="Regular"
                                                       Placeholder="8192"
                                                       Margin="0,0,0,14"/>

                                <TextBlock Text="超时 (秒)"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <shared:GlassTextField x:Name="TimeoutField"
                                                       Variant="Regular"
                                                       Placeholder="60"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource PagePanelStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="可用模型"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="启用常用模型，或从当前提供商自动检测"
                                       Style="{StaticResource SectionMetaStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="EnabledModelCountLabel"
                                   Grid.Column="1"
                                   Text="0 个已启用"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="NoModelsHint"
                               Text="请从下方检测或手动添加模型"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,10"
                               Visibility="Visible"/>

                    <StackPanel x:Name="EnabledModelsPanel"/>

                    <Border Margin="0,18,0,12"
                            Height="1"
                            Background="{DynamicResource BorderDividerBrush}"/>

                    <StackPanel x:Name="DetectingPanel"
                                Orientation="Horizontal"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                        <shared:StatusIndicator Status="Running" Label="正在检测可用模型..."/>
                    </StackPanel>

                    <WrapPanel x:Name="DetectionActionsPanel"
                               Margin="0,0,0,8">
                        <Button x:Name="DetectBtn"
                                Style="{StaticResource InlineTextButtonStyle}"
                                Click="OnDetectModels"
                                Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE11A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="检测可用模型"
                                           FontSize="14"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="EnableAllBtn"
                                Style="{StaticResource InlineTextButtonStyle}"
                                Click="OnEnableAllModels"
                                Visibility="Collapsed"
                                Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE16F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="启用全部"
                                           FontSize="14"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ClearModelsBtn"
                                Style="{StaticResource InlineTextButtonStyle}"
                                Click="OnClearModels"
                                Visibility="Collapsed"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="清空"
                                           FontSize="14"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock x:Name="DetectionMsg"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <StackPanel x:Name="DetectedModelsPanel"/>
                    <StackPanel x:Name="RecommendedModelsPanel"/>
                </StackPanel>
            </Border>

            <shared:StatusIndicator x:Name="ConnStatus"
                                    Label=""
                                    Margin="0,2,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
