<UserControl x:Class="ClaudeCodePanel.Windows.Views.API.APIConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             Loaded="OnLoaded">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,36" HorizontalAlignment="Stretch">

            <!-- ═══ Header ═══ -->
            <shared:SectionHeader Title="API 配置"
                                  Description="配置您的 AI 提供商连接"
                                  Margin="0,0,0,28"/>

            <!-- ═══ Provider Selection ═══ -->
            <shared:GlassCard Title="提供商" Margin="0,0,0,20">
                <StackPanel x:Name="ProviderList"/>
            </shared:GlassCard>

            <!-- ═══ API Key ═══ -->
            <shared:GlassCard Title="API Key" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StatusIndicator x:Name="KeyStatus"
                                                Label="输入后自动加密存储"
                                                Status="Stopped"/>
                        <Button x:Name="CopyKeyBtn"
                                Click="OnCopyKey"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand"
                                Padding="4"
                                Margin="8,0,0,0"
                                ToolTip="复制 API Key">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <shared:GlassTextField x:Name="ApiKeyField"
                                           Placeholder="输入 API Key"
                                           Variant="Secure"
                                           HorizontalAlignment="Stretch"/>
                </StackPanel>
            </shared:GlassCard>

            <!-- ═══ Advanced Options ═══ -->
            <shared:GlassCard Margin="0,0,0,20">
                <Expander x:Name="AdvancedExpander"
                          Header="高级选项"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsExpanded="False"
                          Expanded="OnAdvancedExpanded"
                          Collapsed="OnAdvancedCollapsed">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Base URL"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <shared:GlassTextField x:Name="BaseUrlField"
                                               Variant="Compact"
                                               Placeholder="https://api.anthropic.com"
                                               Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="最大令牌数"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <shared:GlassTextField x:Name="MaxTokensField"
                                                       Variant="Compact"
                                                       Placeholder="8192"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="超时 (秒)"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <shared:GlassTextField x:Name="TimeoutField"
                                                       Variant="Compact"
                                                       Placeholder="60"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>
            </shared:GlassCard>

            <!-- ═══ Models ═══ -->
            <shared:GlassCard Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="可用模型"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="EnabledModelCountLabel"
                                   Text="0 个已启用"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock x:Name="NoModelsHint"
                               Text="请从下方检测或手动添加模型"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,0"
                               Visibility="Visible"/>

                    <StackPanel x:Name="EnabledModelsPanel" Margin="0,6,0,0"/>

                    <shared:GlassDivider/>

                    <StackPanel x:Name="DetectingPanel"
                                Orientation="Horizontal"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                        <shared:StatusIndicator Status="Running" Label="正在检测可用模型..."/>
                    </StackPanel>

                    <StackPanel x:Name="DetectionActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button x:Name="DetectBtn"
                                Click="OnDetectModels"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource AccentBrush}"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE11A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="检测可用模型"
                                           FontSize="15"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="EnableAllBtn"
                                Click="OnEnableAllModels"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource AccentBrush}"
                                Padding="6,4"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE16F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="启用全部"
                                           FontSize="15"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ClearModelsBtn"
                                Click="OnClearModels"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Padding="6,4"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <TextBlock Text="清空"
                                           FontSize="15"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="DetectionMsg"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>

                    <StackPanel x:Name="DetectedModelsPanel" Margin="0,8,0,0"/>
                    <StackPanel x:Name="RecommendedModelsPanel" Margin="0,8,0,0"/>
                </StackPanel>
            </shared:GlassCard>

            <!-- ═══ Connection Status ═══ -->
            <shared:StatusIndicator x:Name="ConnStatus"
                                    Label=""
                                    Margin="0,0,0,16"/>

            <!-- ═══ Action Buttons ═══ -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestConnBtn"
                        Click="OnTestConnection"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Padding="24,10"
                        Margin="0,0,14,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE704;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"/>
                        <TextBlock Text="测试连接"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SaveBtn"
                        Click="OnSaveConfig"
                        Cursor="Hand"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Foreground="White"
                        Padding="24,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"/>
                        <TextBlock Text="保存配置"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
