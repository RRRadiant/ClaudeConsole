<UserControl x:Class="ClaudeCodePanel.Windows.Views.Config.ConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0 — Header ═══ -->
        <shared:SectionHeader Grid.Row="0" Title="配置文件"
                              Description="选择文件并编辑"
                              Margin="48,36,48,20"/>

        <!-- ═══ Row 1 — File tabs ═══ -->
        <StackPanel Grid.Row="1">
            <ScrollViewer x:Name="FileTabsScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="48,0,48,0">
                <StackPanel x:Name="FileTabsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
            <shared:GlassDivider Margin="48,10,48,0"/>
        </StackPanel>

        <!-- ═══ Row 2 — File info bar ═══ -->
        <StackPanel x:Name="FileInfoBar" Grid.Row="2"
                    Orientation="Horizontal" Margin="48,14,48,10"
                    Visibility="Collapsed">
            <TextBlock x:Name="FileIcon"
                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="FilePath"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="6,0" MaxWidth="600"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <shared:StatusIndicator x:Name="SaveStatus"
                                    Label="已保存"
                                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ═══ Row 3 — Editor area ═══ -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="EditorScroller" Visibility="Collapsed">
                <StackPanel Margin="48,0,48,24">

                    <!-- Code editor -->
                    <Border x:Name="EditorBorder" CornerRadius="16"
                            Background="{DynamicResource EditorBackgroundBrush}" Padding="8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="LineNumbers" Width="52"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="12"
                                     Margin="10,12,6,0"
                                     IsHitTestVisible="False"
                                     Focusable="False"/>

                            <TextBox x:Name="Editor" Grid.Column="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="14"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     Margin="0,12,10,0"
                                     TextChanged="OnEditorTextChanged"
                                     MinHeight="200"/>
                        </Grid>
                    </Border>

                    <!-- Save button -->
                    <shared:GlassButton x:Name="SaveButton"
                                        Title="保存更改"
                                        IconGlyph="&#xE74E;"
                                        Variant="Accent"
                                        Size="Small"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"
                                        Visibility="Collapsed"/>

                    <!-- Error message -->
                    <StackPanel x:Name="ErrorPanel" Orientation="Horizontal"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource StatusWarningBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorMsg"
                                   FontSize="13"
                                   Foreground="{DynamicResource StatusWarningBrush}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Empty states -->
            <StackPanel x:Name="NoFilesState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE160;"
                           FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="在 ~/.claude/ 中未找到配置文件"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel x:Name="NoSelectionState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#xED24;"
                           FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请在上方选择一个配置文件"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Conflict overlay ═══ -->
        <Border x:Name="ConflictOverlay" Grid.RowSpan="4"
                Background="{DynamicResource DialogDimmingBrush}" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource OverlayBackgroundBrush}"
                    Padding="28" MaxWidth="800"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Button HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="OnDismissConflict" Padding="4">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>

                    <TextBlock Text="检测到文件冲突"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="文件在您编辑时被外部修改。请选择保留哪个版本。"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="您的更改"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource EditorBackgroundBrush}" CornerRadius="8"
                                    Padding="8" MaxHeight="200"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <TextBlock x:Name="LocalContent"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                            <shared:GlassButton x:Name="AcceptLocalButton"
                                                Title="保留您的"
                                                Variant="Accent"
                                                Size="Regular"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="外部更改"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource EditorBackgroundBrush}" CornerRadius="8"
                                    Padding="8" MaxHeight="200"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <TextBlock x:Name="RemoteContent"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                            <shared:GlassButton x:Name="AcceptRemoteButton"
                                                Title="保留外部"
                                                Variant="Secondary"
                                                Size="Regular"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
