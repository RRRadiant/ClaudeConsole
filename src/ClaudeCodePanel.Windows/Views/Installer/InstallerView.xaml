<UserControl x:Class="ClaudeCodePanel.Windows.Views.Installer.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             Background="{DynamicResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28" MaxWidth="720">
            <StackPanel>

                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="安装器"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="安装和管理 Claude Code CLI"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <shared:GlassCard Variant="Default">
                    <StackPanel Margin="20,18">

                        <!-- Status -->
                        <Border CornerRadius="12"
                                Background="{DynamicResource GlassCardBgBrush}"
                                BorderBrush="{DynamicResource BorderCardBrush}"
                                BorderThickness="1"
                                Padding="16,12"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClaudeStatus.Installed}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusRunningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ClaudeStatus.Installed}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClaudeStatus.Installed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusRunningBrush}"/>
                                                        <Setter Property="Text" Value="已安装"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ClaudeStatus.Installed}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Setter Property="Text" Value="未安装"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ClaudeStatus.Version}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="12"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding ClaudeStatus.Installed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Buttons -->
                        <WrapPanel Margin="0,0,0,16">
                            <shared:GlassButton Variant="Primary"
                                                IconGlyph="&#xEC61;"
                                                Title="npm 安装"
                                                Command="{Binding InstallCommand}"
                                                CommandParameter="Npm"
                                                IsDisabled="{Binding IsInstalling}"
                                                Margin="0,0,8,8"/>
                            <shared:GlassButton Variant="Secondary"
                                                IconGlyph="&#xE756;"
                                                Title="winget 安装"
                                                Command="{Binding InstallCommand}"
                                                CommandParameter="Winget"
                                                IsDisabled="{Binding IsInstalling}"
                                                Margin="0,0,8,8"/>
                            <shared:GlassButton Variant="Danger"
                                                IconGlyph="&#xE74D;"
                                                Title="卸载"
                                                Command="{Binding UninstallCommand}"
                                                IsDisabled="{Binding IsInstalling}"
                                                Margin="0,0,8,8">
                                <shared:GlassButton.Style>
                                    <Style TargetType="shared:GlassButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClaudeStatus.Installed}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </shared:GlassButton.Style>
                            </shared:GlassButton>
                        </WrapPanel>

                        <!-- Installing spinner -->
                        <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <ProgressBar Width="16" Height="16"
                                         IsIndeterminate="True"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="安装中..."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Status message -->
                        <Border CornerRadius="10"
                                Padding="14,10"
                                Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StatusErrorBgBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsErrorMessage}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource StatusRunningBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusRunningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                    </StackPanel>
                </shared:GlassCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
