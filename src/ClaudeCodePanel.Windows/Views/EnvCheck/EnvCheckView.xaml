<UserControl x:Class="ClaudeCodePanel.Windows.Views.EnvCheck.EnvCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClaudeCodePanel.Windows.Views.Shared"
             xmlns:vm="clr-namespace:ClaudeCodePanel.Windows.ViewModels"
             Background="{DynamicResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <!-- ── Dep item template ── -->
        <DataTemplate x:Key="DepItemTemplate" DataType="{x:Type vm:EnvCheckViewModel+DepItem}">
            <Border CornerRadius="12"
                    Background="{DynamicResource GlassCardBgBrush}"
                    BorderBrush="{DynamicResource BorderCardBrush}"
                    BorderThickness="1"
                    Padding="16,14"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status icon -->
                    <TextBlock Grid.Column="0"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                        <Setter Property="Text" Value="&#xE930;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource StatusRunningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Installed}" Value="False">
                                        <Setter Property="Text" Value="&#xE894;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Description + version -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Description}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Version}"
                                   FontSize="11"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding Installed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Status pill -->
                    <Border Grid.Column="2"
                            CornerRadius="10"
                            Padding="10,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StatusRunningBgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Installed}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}"/>
                    </Border>

                    <!-- Download button -->
                    <shared:GlassButton Grid.Column="3"
                                        Variant="Primary"
                                        Size="Small"
                                        IconGlyph="&#xE896;"
                                        Title="下载"
                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                        <shared:GlassButton.Style>
                            <Style TargetType="shared:GlassButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDownloadUrl}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </shared:GlassButton.Style>
                    </shared:GlassButton>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         Environment Check Panel Layout
         ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28" MaxWidth="620">
            <StackPanel>

                <!-- ── Section Header with summary pills ── -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="环境检测"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="检测系统依赖，点击下载跳转浏览器"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Summary pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                        <Border CornerRadius="10"
                                Padding="10,4"
                                Background="{DynamicResource StatusRunningBgBrush}"
                                Margin="0,0,6,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusRunningBrush}">
                                <Run Text="就绪 "/>
                                <Run Text="{Binding ReadyCount}"/>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="10"
                                Padding="10,4"
                                Background="{DynamicResource StatusErrorBgBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusErrorBrush}">
                                <Run Text="缺失 "/>
                                <Run Text="{Binding MissingCount}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Loading Spinner ── -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            Margin="0,60,0,0">
                    <ProgressBar Width="32" Height="32"
                                 IsIndeterminate="True"/>
                    <TextBlock Text="检测中..."
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- ── All OK Banner ── -->
                <Border CornerRadius="12"
                        Padding="16,12"
                        Background="{DynamicResource StatusRunningBgBrush}"
                        Margin="0,0,0,20"
                        Visibility="{Binding AllOk, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="所有依赖已就绪"
                               Foreground="{DynamicResource StatusRunningBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- ── Status Message ── -->
                <Border CornerRadius="10"
                        Padding="14,10"
                        Background="{DynamicResource StatusErrorBgBrush}"
                        Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource StatusErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- ── Dep List ── -->
                <shared:GlassCard Variant="Default"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Deps}"
                                  ItemTemplate="{StaticResource DepItemTemplate}"
                                  Margin="20,18"
                                  Focusable="False"/>
                </shared:GlassCard>

                <!-- ── Batch Download (when missing deps exist) ── -->
                <shared:GlassCard Variant="Aurora"
                                  Margin="0,20,0,0"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolVisibilityConverter}}">
                    <shared:GlassCard.Style>
                        <Style TargetType="shared:GlassCard">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </shared:GlassCard.Style>

                    <StackPanel Margin="20,18" HorizontalAlignment="Center">
                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16">
                            <Run Text="共 "/>
                            <Run Text="{Binding MissingCount}"/>
                            <Run Text=" 项依赖未安装，点击下方按钮跳转浏览器下载"/>
                        </TextBlock>
                        <WrapPanel HorizontalAlignment="Center">
                            <shared:GlassButton IconGlyph="&#xE896;"
                                                Title="下载 Node.js"
                                                Command="{Binding DownloadCommand}"
                                                CommandParameter="node"
                                                Margin="0,0,8,8"/>
                            <shared:GlassButton IconGlyph="&#xE896;"
                                                Title="下载 Git"
                                                Command="{Binding DownloadCommand}"
                                                CommandParameter="git"
                                                Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </shared:GlassCard>

                <!-- ── Refresh Button (when all OK) ── -->
                <shared:GlassButton Variant="Secondary"
                                    IconGlyph="&#xE895;"
                                    Title="重新检测"
                                    Command="{Binding CheckCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,20,0,0"
                                    Visibility="{Binding AllOk, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
