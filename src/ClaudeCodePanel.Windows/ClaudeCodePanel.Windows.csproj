<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>ClaudeConsole</AssemblyName>
    <RootNamespace>ClaudeCodePanel.Windows</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.2.0</Version>
    <Authors>Claude Code Panel</Authors>
    <Description>Claude Code Configuration Panel for Windows</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- TODO: Set TreatWarningsAsErrors=true after all CA violations are resolved -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeCodePanel.Windows.Tests" />
  </ItemGroup>

</Project>
